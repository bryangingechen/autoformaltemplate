/.lake

# Jekyll homepage artifacts (when previewing locally).
home_page/_site
home_page/.bundle
home_page/.jekyll-cache
home_page/.jekyll-metadata
home_page/Gemfile.lock
home_page/vendor

# Generated by leanprover-community/upstreaming-dashboard-action during CI.
home_page/_includes/_upstreaming_dashboard/

# Blueprint artifacts (TeX build is gitignored separately under blueprint/.gitignore).
blueprint/print/
blueprint/web/

# Local-only reference PDFs (papers pulled for citation verification).
.refs/

# macOS Finder metadata.
.DS_Store

# Personal Claude Code harness setup (settings) — but ship the project
# slash commands under .claude/commands/: they carry workflow lessons
# that must propagate to instantiated projects. (A bare `.claude/`
# ignore here once meant coordinate-phase.md silently never reached
# projects instantiated from the template.) The leading `!.claude/`
# also overrides any user-global `**/.claude` exclude.
!.claude/
.claude/*
!.claude/commands/
