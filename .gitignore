/.lake

# Jekyll homepage artifacts (when previewing locally).
home_page/_site
home_page/.bundle
home_page/.jekyll-cache
home_page/.jekyll-metadata
home_page/Gemfile.lock
home_page/vendor

# Generated by leanprover-community/upstreaming-dashboard-action during CI.
home_page/_includes/_upstreaming_dashboard/

# Blueprint artifacts (TeX build is gitignored separately under blueprint/.gitignore).
blueprint/print/
blueprint/web/

# Local-only reference PDFs (papers pulled for citation verification).
.refs/

# macOS Finder metadata.
.DS_Store

# Personal Claude Code harness setup — but ship the project slash
# commands under .claude/commands/, the subagent definitions under
# .claude/agents/, the safety hooks under .claude/hooks/, and the
# project settings.json that wires the hooks: they carry workflow
# lessons and mechanical guards that must propagate to instantiated
# projects. (A bare `.claude/` ignore here once meant
# coordinate-phase.md silently never reached projects instantiated
# from the template; a gitignored settings.json meant the lake-update
# hook stayed machine-local on the repo whose OOM crash motivated it;
# an un-whitelisted .claude/agents/ silently dropped the agent
# definitions from the commit that introduced them.) Personal
# overrides go in settings.local.json, which stays ignored. The
# leading `!.claude/` also overrides any user-global `**/.claude`
# exclude.
!.claude/
.claude/*
!.claude/agents/
!.claude/commands/
!.claude/hooks/
!.claude/settings.json
